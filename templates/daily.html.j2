<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI 每日早报 · {{ date_str }}</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #0f1117; --bg2: #161b26; --bg3: #1e2435; --border: #2a3044;
      --accent: #7c6af7; --accent2: #5be0c4; --accent3: #f77c6a;
      --text: #e4e8f0; --text2: #9aa5b8; --text3: #5e6e88;
      --pill-blue: rgba(124,106,247,0.15); --pill-green: rgba(91,224,196,0.15);
      --pill-red: rgba(247,124,106,0.15); --pill-yellow: rgba(247,210,106,0.15);
      --yellow: #f7d26a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif; font-size: 14px; line-height: 1.6; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .site-header { background: linear-gradient(135deg, #1a1535 0%, #121830 100%); border-bottom: 1px solid var(--border); padding: 20px 28px 16px; }
    .header-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .header-title { display: flex; align-items: center; gap: 12px; }
    .header-title h1 { font-size: 22px; font-weight: 700; color: #fff; }
    .header-title .date-badge { background: var(--pill-blue); border: 1px solid var(--accent); color: var(--accent); padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .stat-pills { display: flex; gap: 8px; flex-wrap: wrap; }
    .stat-pill { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 5px; }
    .pill-p { background: var(--pill-blue); color: var(--accent); border: 1px solid rgba(124,106,247,0.3); }
    .pill-g { background: var(--pill-green); color: var(--accent2); border: 1px solid rgba(91,224,196,0.3); }
    .pill-s { background: var(--pill-red); color: var(--accent3); border: 1px solid rgba(247,124,106,0.3); }

    .stat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 16px 28px 0; }
    .stat-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; }
    .stat-icon { font-size: 24px; }
    .stat-num { font-size: 22px; font-weight: 700; color: #fff; }
    .stat-label { font-size: 11px; color: var(--text2); margin-top: 1px; }

    .highlights { margin: 16px 28px 0; background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; }
    .highlights h2 { font-size: 14px; font-weight: 700; color: var(--yellow); margin-bottom: 12px; }
    .highlights-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .hl-col h3 { font-size: 12px; font-weight: 600; color: var(--text2); margin-bottom: 6px; }
    .hl-col ul { list-style: none; }
    .hl-col li { font-size: 12px; color: var(--text); padding: 2px 0; padding-left: 10px; position: relative; }
    .hl-col li::before { content: '▸'; position: absolute; left: 0; color: var(--accent); font-size: 10px; top: 2px; }
    .highlights-conclusion { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); font-size: 12px; color: var(--yellow); font-style: italic; }

    .main-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; padding: 16px 28px 28px; align-items: start; }
    .left-col, .right-col { display: flex; flex-direction: column; gap: 16px; }

    .section-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    .section-header { padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .section-header h2 { font-size: 14px; font-weight: 700; color: #fff; }
    .section-tag { font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
    .tag-blue { background: var(--pill-blue); color: var(--accent); }
    .tag-green { background: var(--pill-green); color: var(--accent2); }
    .tag-yellow { background: var(--pill-yellow); color: var(--yellow); }
    .tag-red { background: var(--pill-red); color: var(--accent3); }

    .paper-item { padding: 12px 16px; border-bottom: 1px solid var(--border); }
    .paper-item:last-child { border-bottom: none; }
    .paper-title { font-size: 13px; font-weight: 600; color: #fff; margin-bottom: 3px; }
    .paper-meta { font-size: 11px; color: var(--text3); margin-bottom: 5px; }
    .paper-abstract { font-size: 12px; color: var(--text2); line-height: 1.55; }
    .paper-tags { display: flex; gap: 5px; margin-top: 6px; flex-wrap: wrap; }
    .paper-tag { font-size: 10px; padding: 1px 7px; border-radius: 8px; background: var(--bg3); color: var(--text3); border: 1px solid var(--border); }

    .repo-item { padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; gap: 12px; align-items: flex-start; }
    .repo-item:last-child { border-bottom: none; }
    .repo-icon { font-size: 22px; line-height: 1; padding-top: 2px; }
    .repo-content { flex: 1; min-width: 0; }
    .repo-title { font-size: 13px; font-weight: 600; color: #fff; margin-bottom: 2px; }
    .repo-desc { font-size: 12px; color: var(--text2); margin-bottom: 5px; }
    .repo-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .repo-stars { font-size: 11px; color: var(--yellow); font-weight: 600; }
    .repo-lang { font-size: 10px; color: var(--text3); }

    .hn-item { padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; gap: 10px; align-items: flex-start; }
    .hn-item:last-child { border-bottom: none; }
    .hn-rank { font-size: 11px; font-weight: 700; color: var(--text3); min-width: 18px; padding-top: 1px; }
    .hn-content { flex: 1; }
    .hn-title { font-size: 12px; font-weight: 600; color: #fff; margin-bottom: 2px; }
    .hn-meta { font-size: 11px; color: var(--text3); }
    .hn-points { color: var(--accent3); font-weight: 600; }

    .radar-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 8px; }
    .radar-item { padding: 8px 10px; border-radius: 6px; margin: 4px; background: var(--bg3); border: 1px solid var(--border); }
    .radar-name { font-size: 12px; font-weight: 700; color: #fff; margin-bottom: 2px; }
    .radar-bar-wrap { background: var(--bg); border-radius: 4px; height: 4px; margin-bottom: 3px; }
    .radar-bar { height: 4px; border-radius: 4px; }
    .radar-desc { font-size: 10px; color: var(--text3); }

    .chart-wrap { padding: 12px 16px; }
    canvas { max-height: 180px; }

    .score-badge { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 6px; background: rgba(124,106,247,0.2); color: var(--accent); margin-left: 6px; vertical-align: middle; }

    .footer { text-align: center; padding: 20px; color: var(--text3); font-size: 11px; border-top: 1px solid var(--border); margin-top: 8px; }

    @media (max-width: 960px) { .main-grid { grid-template-columns: 1fr; } .stat-cards { grid-template-columns: repeat(2, 1fr); } .highlights-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .stat-cards { grid-template-columns: 1fr 1fr; } }
  </style>
</head>
<body>

<!-- ════════ HEADER ════════ -->
<header class="site-header">
  <div class="header-top">
    <div class="header-title">
      <h1>🤖 AI 每日早报</h1>
      <span class="date-badge">{{ date_str }} · {{ weekday_str }}</span>
    </div>
    <div class="stat-pills">
      <span class="stat-pill pill-p">📄 {{ arxiv_items|length + hf_items|length }} Papers</span>
      <span class="stat-pill pill-g">🚀 {{ github_items|length }} Repos</span>
      <span class="stat-pill pill-s">🟠 {{ hn_items|length }} HN</span>
    </div>
  </div>
</header>

<!-- ════════ STAT CARDS ════════ -->
<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-icon">📑</div>
    <div>
      <div class="stat-num">{{ arxiv_items|length + hf_items|length }}</div>
      <div class="stat-label">今日论文（arXiv + HF）</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">⭐</div>
    <div>
      <div class="stat-num">{{ stats.max_stars }}</div>
      <div class="stat-label">最高 Stars（{{ stats.max_stars_repo }}）</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">🚀</div>
    <div>
      <div class="stat-num">{{ github_items|length }}</div>
      <div class="stat-label">GitHub 新兴仓库</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">💬</div>
    <div>
      <div class="stat-num">{{ stats.top_hn_score }}</div>
      <div class="stat-label">HN 最高分（{{ stats.top_hn_title }}）</div>
    </div>
  </div>
</div>

<!-- ════════ TODAY'S HIGHLIGHTS ════════ -->
<div class="highlights">
  <h2>⚡ 今日要点（看完这里可不看其他）</h2>
  <div class="highlights-grid">
    <div class="hl-col">
      <h3>📄 论文</h3>
      <ul>
        {% for item in top_papers %}
        <li>{{ item.title[:60] }}{% if item.title|length > 60 %}…{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="hl-col">
      <h3>🚀 GitHub</h3>
      <ul>
        {% for item in top_github %}
        <li>{{ item.title }}{% if item.stars > 0 %}（{{ item.stars | format_stars }} ⭐）{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="hl-col">
      <h3>🟠 HackerNews</h3>
      <ul>
        {% for item in top_hn %}
        <li>{{ item.title[:55] }}{% if item.title|length > 55 %}…{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="hl-col">
      <h3>🔥 今日高分</h3>
      <ul>
        {% for item in top_all %}
        <li>【{{ item.source | source_label }}】{{ item.title[:42] }}{% if item.title|length > 42 %}…{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% if daily_insight %}
  <div class="highlights-conclusion">
    💡 <strong>今日结论</strong>：{{ daily_insight }}
  </div>
  {% endif %}
</div>

<!-- ════════ MAIN GRID ════════ -->
<div class="main-grid">

  <!-- ══ LEFT COL ══ -->
  <div class="left-col">

    <!-- arXiv Papers -->
    <div class="section-card">
      <div class="section-header">
        <h2>📄 arXiv 最新论文</h2>
        <span class="section-tag tag-blue">cs.AI · cs.CL · cs.MA</span>
      </div>
      {% for item in arxiv_items %}
      <div class="paper-item">
        <div class="paper-title">
          <a href="{{ item.url }}" target="_blank">{{ item.title }}</a>
          <span class="score-badge">{{ "%.1f"|format(item.score) }}</span>
        </div>
        {% if item.authors or item.published_at %}
        <div class="paper-meta">{{ item.authors[:3]|join(', ') }}{% if item.authors|length > 3 %} 等{% endif %}{% if item.published_at %} · {{ item.published_at[:10] }}{% endif %}</div>
        {% endif %}
        <div class="paper-abstract">{{ item.summary if item.summary else item.raw_abstract[:200] }}</div>
        {% if item.tags %}
        <div class="paper-tags">
          {% for tag in item.tags[:5] %}<span class="paper-tag">{{ tag }}</span>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% else %}
      <div class="paper-item" style="color:var(--text3);font-size:12px;">今日暂无 arXiv 论文数据</div>
      {% endfor %}
    </div>

    <!-- HuggingFace Papers -->
    <div class="section-card">
      <div class="section-header">
        <h2>🤗 HuggingFace Daily Papers</h2>
        <span class="section-tag tag-green">今日热门</span>
      </div>
      {% for item in hf_items %}
      <div class="paper-item">
        <div class="paper-title">
          <a href="{{ item.url }}" target="_blank">{{ item.title }}</a>
          {% if item.stars > 0 %}<span class="score-badge">{{ item.stars }} 👍</span>{% endif %}
        </div>
        {% if item.authors %}
        <div class="paper-meta">{{ item.authors[:2]|join(', ') }}{% if item.authors|length > 2 %} 等{% endif %}{% if item.stars > 0 %} · {{ item.stars }} 👍{% endif %}</div>
        {% endif %}
        <div class="paper-abstract">{{ item.summary if item.summary else item.raw_abstract[:200] }}</div>
        {% if item.tags %}
        <div class="paper-tags">
          {% for tag in item.tags[:5] %}<span class="paper-tag">{{ tag }}</span>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% else %}
      <div class="paper-item" style="color:var(--text3);font-size:12px;">今日暂无 HuggingFace 论文数据</div>
      {% endfor %}
    </div>

    <!-- HackerNews -->
    <div class="section-card">
      <div class="section-header">
        <h2>🟠 HackerNews AI 热议</h2>
        <span class="section-tag tag-red">高分讨论</span>
      </div>
      {% for item in hn_items %}
      <div class="hn-item">
        <div class="hn-rank">#{{ loop.index }}</div>
        <div class="hn-content">
          <div class="hn-title"><a href="{{ item.url }}" target="_blank">{{ item.title }}</a></div>
          <div class="hn-meta">
            <span class="hn-points">{{ item.stars }} pts</span>
            {% if item.published_at %} · {{ item.published_at[:10] }}{% endif %}
          </div>
        </div>
      </div>
      {% else %}
      <div class="hn-item" style="color:var(--text3);font-size:12px; padding:12px 16px;">今日暂无 HackerNews 数据</div>
      {% endfor %}
    </div>

  </div><!-- /left-col -->

  <!-- ══ RIGHT COL ══ -->
  <div class="right-col">

    <!-- GitHub Trending -->
    <div class="section-card">
      <div class="section-header">
        <h2>🚀 近期新兴 GitHub 仓库</h2>
        <span class="section-tag tag-green">快速涨星</span>
      </div>
      {% for item in github_items %}
      <div class="repo-item">
        <div class="repo-icon">{{ loop.cycle('📈','🔧','🧑‍🔬','🔍','🎬','⚡','🛠','🧠') }}</div>
        <div class="repo-content">
          <div class="repo-title"><a href="{{ item.url }}" target="_blank">{{ item.title }}</a></div>
          <div class="repo-desc">{{ item.summary if item.summary else item.raw_abstract[:120] }}</div>
          <div class="repo-meta">
            {% if item.stars > 0 %}<span class="repo-stars">⭐ {{ item.stars | format_stars }}</span>{% endif %}
            {% for tag in item.tags[:2] %}<span class="repo-lang">{{ tag }}</span>{% endfor %}
          </div>
        </div>
      </div>
      {% else %}
      <div class="repo-item" style="color:var(--text3);font-size:12px; padding:12px 16px;">今日暂无 GitHub 数据</div>
      {% endfor %}
    </div>

    <!-- Tech Radar -->
    <div class="section-card">
      <div class="section-header">
        <h2>📡 技术雷达</h2>
        <span class="section-tag tag-blue">关键词热度</span>
      </div>
      <div class="radar-grid">
        {% for r in radar_items %}
        <div class="radar-item">
          <div class="radar-name">{{ r.name }}</div>
          <div class="radar-bar-wrap"><div class="radar-bar" style="width:{{ r.score }}%;background:{{ r.color }};"></div></div>
          <div class="radar-desc">{{ r.desc }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- Keyword Trend Chart -->
    <div class="section-card">
      <div class="section-header">
        <h2>📊 关键词热度趋势（7天）</h2>
        <span class="section-tag tag-green">Agent / MCP / RAG</span>
      </div>
      <div class="chart-wrap">
        <canvas id="trendChart"></canvas>
      </div>
    </div>

  </div><!-- /right-col -->

</div><!-- /main-grid -->

<div class="footer">
  由 AI Pipeline 自动生成 · {{ generated_at }} · <a href="./index.html">← 返回首页</a>
</div>

<script>
const ctx = document.getElementById('trendChart').getContext('2d');
new Chart(ctx, {
  type: 'line',
  data: {
    labels: {{ trend_labels | tojson }},
    datasets: [
      { label: 'Agent', data: {{ trend_agent | tojson }}, borderColor: '#7c6af7', backgroundColor: 'rgba(124,106,247,0.08)', tension: 0.4, fill: true, pointRadius: 3, borderWidth: 2 },
      { label: 'MCP',   data: {{ trend_mcp   | tojson }}, borderColor: '#5be0c4', backgroundColor: 'rgba(91,224,196,0.06)',  tension: 0.4, fill: true, pointRadius: 3, borderWidth: 2 },
      { label: 'RAG',   data: {{ trend_rag   | tojson }}, borderColor: '#f77c6a', backgroundColor: 'rgba(247,124,106,0.06)', tension: 0.4, fill: true, pointRadius: 3, borderWidth: 2 }
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { labels: { color: '#9aa5b8', font: { size: 11 }, boxWidth: 12 } },
      tooltip: { backgroundColor: '#1e2435', borderColor: '#2a3044', borderWidth: 1, titleColor: '#e4e8f0', bodyColor: '#9aa5b8' }
    },
    scales: {
      x: { ticks: { color: '#5e6e88', font: { size: 10 } }, grid: { color: 'rgba(42,48,68,0.6)' } },
      y: { ticks: { color: '#5e6e88', font: { size: 10 } }, grid: { color: 'rgba(42,48,68,0.6)' }, min: 0, max: 100 }
    }
  }
});
</script>
</body>
</html>
